# MedLens Backend Environment Configuration
PROJECT_NAME="MedLens API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./medlens.db"

# Allowed CORS Origins (comma-separated or JSON array)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Gemini AI Configuration (Phase 3)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Document Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=26214400
